# ============================================================
# PawCure — Variables de entorno
# ============================================================
# Copia este archivo como `.env.local` y rellena los valores:
#
#   cp .env.example .env.local
#
# `.env.local` esta en .gitignore: nunca lo subas al repositorio.
#
# Donde obtener los valores:
#   Supabase Dashboard > tu proyecto > Project Settings > API Keys
# ============================================================

# URL del proyecto de Supabase.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co

# Clave publicable del proyecto (empieza con `sb_publishable_`).
# Es segura de exponer en el navegador: viaja en el bundle del cliente
# y el acceso a los datos lo restringen las politicas RLS definidas en
# supabase/migrations/.
#
# NO uses aqui la secret key (`sb_secret_`) ni la antigua service_role:
# esas omiten RLS por completo y jamas deben llegar al cliente ni al
# repositorio.
#
# Nota: Supabase renombro sus claves de API. La antigua `anon key` es
# ahora la `publishable key`. Si tu proyecto todavia muestra el nombre
# viejo, el valor `anon` funciona igual en esta variable.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
